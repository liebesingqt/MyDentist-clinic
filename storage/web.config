<?xml version="1.0" encoding="UTF-8"?>
<!-- Windows (IIS) hosting: block all web access to this folder (same job as .htaccess on Apache) -->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <fileExtensions allowUnlisted="false" />
        <hiddenSegments>
          <add segment="mail" />
          <add segment="backups" />
          <add segment="avatars" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
